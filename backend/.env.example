# Local development environment variables.
# Copy this as .env.example (without real secrets) before committing —
# the real .env must stay out of git (add it to .gitignore).

# --- App ---
APP_NAME=Finance Tracker
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Host "db" / "db_test" work when running inside Docker Compose;
# use "localhost" instead if running uvicorn directly on your machine.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/finance_tracker
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@db_test:5432/finance_tracker_test

# --- Auth / JWT ---
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-random-256-bit-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Registration ---
# approval: new accounts stay pending until you approve them from the email sent
# to ADMIN_EMAIL. open: anyone can register (switch to this to open the app up).
REGISTRATION_MODE=approval
ADMIN_EMAIL=
# Public URL of the frontend; the links in the emails point here.
FRONTEND_BASE_URL=http://localhost:5173
APPROVAL_TOKEN_EXPIRE_DAYS=14

# --- Email (SMTP) ---
# Leave SMTP_HOST empty in development: emails are written to the backend log
# (make logs) instead of being sent. Required in production with approval mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- External APIs ---
EXCHANGE_RATE_API_BASE_URL=https://api.frankfurter.app
YAHOO_FINANCE_API_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart
COINGECKO_API_KEY=
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3

# --- Defaults ---
DEFAULT_BASE_CURRENCY=EUR
