# Production image (Render). The dev image is `Dockerfile`: it keeps the dev
# tools and runs with --reload from a bind mount; this one must not.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY pyproject.toml poetry.lock ./
# --only main: no pytest/ruff/mypy in the image that faces the internet.
RUN pip install --no-cache-dir --upgrade pip poetry \
    && poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-root --only main \
    && pip uninstall -y poetry

COPY . .

# Not root: a bug in the app shouldn't hand over the container.
RUN useradd --create-home --uid 10001 app && chown -R app:app /app
USER app

# Render injects $PORT. One worker, on purpose: the rate limiter and the CSV
# preview live in process memory (see CLAUDE.md), so more workers would each
# count separately. No uvicorn --proxy-headers: the app resolves the client IP
# itself from TRUSTED_PROXY_COUNT (core/rate_limit.py), because trusting
# X-Forwarded-For wholesale lets a caller dodge the rate limiter.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
